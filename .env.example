# ===== Оценка ИИ (OpenRouter) =====
# Ключ: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Модель для оценки. Точное название смотрите на https://openrouter.ai/models
# (дешевле всего — Haiku; если оценки неточные — anthropic/claude-sonnet-5.5)
LLM_MODEL=anthropic/claude-haiku-5.5
# Глубина рассуждений модели: пусто (по умолчанию), low, medium, high. Выше — точнее, но дороже.
LLM_REASONING_EFFORT=

# ===== Веб-интерфейс =====
CLINIC_NAME=Варикоза нет
PORT=8000
# Пароль для входа (логин admin). Пусто — без пароля (только для доступа внутри клиники).
APP_PASSWORD=

# ===== Расшифровка записей (работает на этом компьютере) =====
# large-v3-turbo — лучшее качество; medium или small — быстрее на слабом компьютере
WHISPER_MODEL=large-v3-turbo
# Сколько ядер процессора использовать (0 — автоматически)
WHISPER_THREADS=0
# Канал администратора в стерео-записи: auto (определить по разговору), left, right
STEREO_ADMIN_CHANNEL=auto
# Если модель расшифровки не скачивается, раскомментируйте зеркало:
# HF_ENDPOINT=https://hf-mirror.com

# ===== Обработка =====
# Звонки короче этого числа секунд не оцениваются
MIN_CALL_SECONDS=20
