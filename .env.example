# ===== Оценка ИИ (OpenRouter) =====
# Ключ: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Модель для оценки звонков. Точные названия — на https://openrouter.ai/models
#   anthropic/claude-haiku-5.5  — ~0,3 ₽ за звонок, ошибается в ~2–3% пунктов, обратная связь иногда неточна
#   anthropic/claude-sonnet-5.5 — ~4–6 ₽ за звонок, на проверке без явных ошибок, обратная связь точнее
LLM_MODEL=anthropic/claude-haiku-5.5
# Модель для определения типа звонка (с этим справляется дешёвая)
LLM_CLASSIFY_MODEL=anthropic/claude-haiku-5.5
# Модель для кнопки «Переоценить точной моделью» в карточке звонка
LLM_PRECISE_MODEL=anthropic/claude-sonnet-5.5
# Глубина рассуждений модели: пусто (по умолчанию), low, medium, high. Выше — точнее, но дороже.
LLM_REASONING_EFFORT=

# ===== Веб-интерфейс =====
CLINIC_NAME=Варикоза нет
PORT=8000
# Пароль для входа (логин admin). Пусто — без пароля (только для доступа внутри клиники).
APP_PASSWORD=

# ===== Расшифровка записей (работает на этом компьютере) =====
# Модели (GigaAM, ~270 МБ) скачиваются с github.com при первой расшифровке.
# Сколько ядер процессора использовать (0 — автоматически, до 4)
ASR_THREADS=0
# Разделять администратора и пациента по голосу в моно-записях (Mango пишет в моно)
DIARIZATION=true
# Канал администратора в стерео-записи: auto (определить по разговору), left, right
STEREO_ADMIN_CHANNEL=auto

# ===== Записи Mango =====
# Время в именах файлов Mango — московское. Сколько часов прибавить до местного времени клиники
# (Владивосток = +7). Нужно, чтобы правильно проверять приветствие по времени суток.
MANGO_TIME_SHIFT_HOURS=7

# ===== Обработка =====
# Звонки короче этого числа секунд не оцениваются
MIN_CALL_SECONDS=20
